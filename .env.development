OPENAI_API_KEY=
GEMINI_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=

# CORS — comma-separated list of allowed frontend origins
# Leave empty to allow all origins (local dev only)
# Production example: ALLOWED_ORIGINS=https://app.yourdomain.com,https://yourdomain.com
ALLOWED_ORIGINS=

# Database — use DATABASE_URL for local/VPS postgres; NEON_DATABASE_URL kept for legacy
DATABASE_URL=
NEON_DATABASE_URL=

# Auth — generate with: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO